rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function currentUserRole() {
      return isSignedIn() && currentUserDoc().exists()
        ? currentUserDoc().data.role
        : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    function isCoordinator() {
      return currentUserRole() == 'coordinator';
    }

    function isMember() {
      return currentUserRole() == 'member';
    }

    function isCoordinatorOrAdmin() {
      return isCoordinator() || isAdmin();
    }

    function isMainAdminTarget() {
      return resource != null
        && resource.data != null
        && resource.data.email == 'admin@gj.com';
    }

    function isMainAdminRequest() {
      return request.resource != null
        && request.resource.data != null
        && request.resource.data.email == 'admin@gj.com';
    }

    match /members/{memberId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        request.auth.uid == memberId ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isCoordinatorOrAdmin() &&
          !isMainAdminTarget() &&
          resource.data.role == 'member' &&
          request.resource.data.role == 'member'
        ) ||
        (
          request.auth.uid == memberId &&
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isSignedIn() && (
        isAdmin() && !isMainAdminTarget() ||
        (isCoordinator() && !isMainAdminTarget() && resource.data.role == 'member')
      );
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoordinatorOrAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isCoordinatorOrAdmin();
      allow create, update, delete: if isCoordinatorOrAdmin();
    }

    match /contributions/{contributionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isCoordinatorOrAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}