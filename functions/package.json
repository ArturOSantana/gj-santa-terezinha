{
  "name": "functions",
  "description": "Firebase Functions para GJ Santa Terezinha - Sistema Boa Nova",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:email": "node test-email.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.6.0",
    "dotenv": "^16.4.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "googleapis": "^172.0.0",
    "nodemailer": "^6.9.7",
    "pino": "^8.21.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.0"
  },
  "private": true
}
