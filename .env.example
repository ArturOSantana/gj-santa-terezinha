# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Sheets — Agenda dos Jovens (Eventos)
# ID da planilha: retire da URL https://docs.google.com/spreadsheets/d/ID_AQUI/edit
VITE_SHEETS_ID=sua-planilha-id-aqui
# Chave de API pública do Google Cloud (ative Sheets API + Calendar API no mesmo projeto)
# Restrinja ao domínio do site em: APIs e Serviços → Credenciais → Restrições de aplicativo
VITE_SHEETS_API_KEY=sua-api-key-aqui

# Google Calendar — Aniversariantes dos Jovens
# ID do calendário: nas configurações do Google Calendar → "Endereço do calendário"
# Exemplo: abc123xyz@group.calendar.google.com  ou  seu-email@gmail.com
VITE_GOOGLE_CALENDAR_ID=seu_calendar_id_aqui



# Novenas — API pública de novenas do mês
# Endpoint esperado: GET {URL}/current → retorna a novena em andamento
# Campos retornados: name, currentDay, startDate, endDate, dayTitle, prayer
VITE_NOVENA_API_URL=https://sua-api.com/novenas

# ─────────────────────────────────────────────────────────────────────────────
# TEMAS FESTIVOS
# Não há variável de ambiente para o sistema de temas.
# Os temas padrão (Santa Terezinha, São José, Carlo Acutis, Frassati,
# Nossa Senhora, Joana d'Arc e Santo Inácio) são gerados automaticamente
# com base nas datas litúrgicas hardcoded em src/services/theme.service.ts.
#
# Temas customizados e datas ajustadas são configurados pelo admin no painel
# "Temas" (coleção Firestore: agenda_themes).
#
# Para adicionar o brasão de um santo, faça upload do PNG/SVG para o
# Firebase Storage e cole a URL pública no campo "URL do brasão" do painel.
# ─────────────────────────────────────────────────────────────────────────────
