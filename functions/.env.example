# Firebase Functions - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# Gmail SMTP Configuration
# Para gerar uma senha de app:
# 1. Acesse: https://myaccount.google.com/apppasswords
# 2. Selecione "Outro (nome personalizado)"
# 3. Digite: "Boa Nova - GJ Santa Terezinha"
# 4. Copie a senha de 16 caracteres gerada

GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=

# Configurações Opcionais
# NODE_ENV=development
# LOG_LEVEL=debug