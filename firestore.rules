rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ REGRAS TEMPORÁRIAS - PERMITEM TUDO PARA USUÁRIOS AUTENTICADOS
    // TODO: Implementar regras de segurança adequadas após testes
    
    match /{document=**} {
      // Permite TUDO para qualquer usuário autenticado
      allow read, write: if request.auth != null;
    }
  }
}