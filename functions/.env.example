# Firebase Functions - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# Gmail SMTP Configuration
# Para gerar uma senha de app:
# 1. Acesse: https://myaccount.google.com/apppasswords
# 2. Selecione "Outro (nome personalizado)"
# 3. Digite: "Boa Nova - GJ Santa Terezinha"
# 4. Copie a senha de 16 caracteres gerada

GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=

# Google Service Account (JSON completo, numa única linha)
# Usada para: Google Calendar (escrita) + Google Sheets (escrever eventos)
# Obter em: console.cloud.google.com → IAM → Contas de serviço → Criar chave → JSON
# Depois compartilhe a planilha com o e-mail da service account como "Editor"
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"nome@projeto.iam.gserviceaccount.com",...}

# ID da planilha do Google Sheets (mesmo valor do VITE_SHEETS_ID no .env do frontend)
# Extraído da URL: https://docs.google.com/spreadsheets/d/ID_AQUI/edit
SHEETS_ID=sua-planilha-id-aqui

# Configurações Opcionais
# NODE_ENV=development
# LOG_LEVEL=debug