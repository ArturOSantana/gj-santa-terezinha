rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function currentUserExists() {
      return isSignedIn() && currentUserDoc().data != null;
    }

    function currentUserRole() {
      return currentUserExists() ? currentUserDoc().data.role : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    function isCoordinator() {
      return currentUserRole() == 'coordinator';
    }

    function isCoordinatorOrAdmin() {
      return isCoordinator() || isAdmin();
    }

    function isMainAdminEmail(email) {
      return email == 'admin@gj.com';
    }

    function isSelf(memberId) {
      return isSignedIn() && request.auth.uid == memberId;
    }

    function creatingOwnProfile(memberId) {
      return isSelf(memberId)
        && !exists(/databases/$(database)/documents/members/$(memberId));
    }

    function updatingOwnProfileWithoutRoleChange() {
      return request.resource.data.role == resource.data.role;
    }

    match /members/{memberId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          creatingOwnProfile(memberId) &&
          request.resource.data.id == request.auth.uid &&
          request.resource.data.email is string &&
          (
            request.resource.data.role == 'member' ||
            (
              isMainAdminEmail(request.resource.data.email) &&
              request.resource.data.role == 'admin'
            )
          )
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isCoordinator() &&
          resource.data.role == 'member' &&
          request.resource.data.role == 'member' &&
          resource.data.email != 'admin@gj.com'
        ) ||
        (
          isSelf(memberId) &&
          updatingOwnProfileWithoutRoleChange()
        )
      );

      allow delete: if isSignedIn() && (
        (isAdmin() && resource.data.email != 'admin@gj.com') ||
        (isCoordinator() && resource.data.role == 'member' && resource.data.email != 'admin@gj.com')
      );
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoordinatorOrAdmin();
    }

    match /transactions/{transactionId} {
      allow read, create, update, delete: if isCoordinatorOrAdmin();
    }

    match /contributions/{contributionId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isCoordinatorOrAdmin();
    }

    // Boa Nova - Sistema de envio de mensagens
    match /boanova_broadcasts/{broadcastId} {
      allow read: if isCoordinatorOrAdmin();
      allow create: if isCoordinatorOrAdmin();
      allow update, delete: if isCoordinatorOrAdmin();
    }
    
    // WhatsApp Sessions - Apenas coordenadores e admins
    match /boanova_whatsapp_sessions/{sessionId} {
      allow read, write: if isCoordinatorOrAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}